---
// The admin shell: navigation and sign-out. The middleware already refused a request without a session; a page that
// uses this layout still reads `Astro.locals.admin` and every action starts with `requireAdmin`.
import { actions } from 'astro:actions';
import { loginPath } from '../lib/session.ts';
import { runtime } from '../server/runtime.ts';
import { getSiteName } from '../server/Site.ts';
import BaseLayout from './BaseLayout.astro';

interface Props {
    title: string;
}

const { title } = Astro.props;
const admin = Astro.locals.admin;
const siteName = getSiteName(runtime().db);
---

<BaseLayout title={`${title} | ${siteName} admin`} noindex>
    <header slot="bar" class="admin-bar">
        <nav aria-label="Admin">
            <strong>{siteName}</strong>
            <a href="/admin">Dashboard</a>
            <a href="/">View site</a>
        </nav>
        {admin && (
            <form method="POST" action={`${loginPath}${actions.logout}`}>
                <span class="muted">{admin.email}</span>
                <button type="submit">Sign out</button>
            </form>
        )}
    </header>
    <slot />
</BaseLayout>
