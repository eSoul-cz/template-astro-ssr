# KEY=value, no spaces around "=". Locally this is `.env` (read by `pnpm dev`, `pnpm start` and the scripts of src/server/);
# in production the stack's environment provides the same variables. Every value is validated when the server starts and
# when `pnpm migrate` runs: a typo exits with a message instead of breaking the running site.

# Public origin of the site, https:// in production (http:// only for localhost). Canonical links, sitemap, the Secure flag of
# the session cookie and, at BUILD time, `security.allowedDomains` (the Docker image gets it as a build argument).
SITE_URL=http://localhost:4321

# Where the server listens. The Docker image sets HOST=0.0.0.0 and PORT=4321 itself.
HOST=localhost
PORT=4321

# Directory with the SQLite file (app.db). Relative to the working directory; in Docker it is /app/data (bind mount).
DATA_DIR=data

# Required. Keys the stored session ids and the login throttle: at least 32 random characters, one per environment.
#   openssl rand -base64 32
# Changing it signs every admin out.
SESSION_SECRET=
# Session lifetime in days. Default: 30
SESSION_TTL_DAYS=

# Failed-login limit per client address + e-mail within the window. Defaults: 5 attempts per 15 minutes
LOGIN_MAX_ATTEMPTS=
LOGIN_WINDOW_MINUTES=

# Staging gate: with PUBLIC_NOINDEX=true every page gets `noindex,nofollow` and robots.txt disallows everything.
# Leave it unset (or false) in production.
PUBLIC_NOINDEX=false

# Optional, Docker only: copy the client files (dist/client) into this directory on every start, for a web server that
# serves them from the host (the node-http deploy hook does the same with `docker cp`).
CLIENT_COPY_DIR=

# There is no admin password here on purpose: the first admin is created with `pnpm admin:create <email>`.
